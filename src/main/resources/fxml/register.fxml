<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5; -fx-font-family: 'Segoe UI', Tahoma, Arial, sans-serif;" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.furever.client.ui.RegisterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    
    <Label text="הרשמה" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <VBox.margin>
            <Insets bottom="10.0"/>
        </VBox.margin>
    </Label>
    
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="שם משתמש:" prefWidth="100"/>
            <TextField fx:id="usernameField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="סיסמה:" prefWidth="100"/>
            <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="אישור סיסמה:" prefWidth="100"/>
            <PasswordField fx:id="confirmPasswordField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="שם מלא:" prefWidth="100"/>
            <TextField fx:id="fullNameField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="אימייל:" prefWidth="100"/>
            <TextField fx:id="emailField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="טלפון:" prefWidth="100"/>
            <TextField fx:id="phoneField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="קוד אדמין (אופציונלי):" prefWidth="100"/>
            <TextField fx:id="adminCodeField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT" promptText="הכנס קוד להרשמה כאדמין"/>
        </HBox>
        <Label text="השאר ריק להרשמה כמשתמש רגיל" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" nodeOrientation="RIGHT_TO_LEFT"/>
        
        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" wrapText="true" maxWidth="250"/>
        
        <HBox spacing="10" alignment="CENTER">
            <Button text="הרשם" onAction="#handleRegister" prefWidth="120" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="ביטול" onAction="#handleCancel" prefWidth="120" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</VBox>
