<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f5f5f5; -fx-font-family: 'Segoe UI', Tahoma, Arial, sans-serif;" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.furever.client.ui.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    
    <Label text="FurEver" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <VBox.margin>
            <Insets bottom="10.0"/>
        </VBox.margin>
    </Label>
    
    <Label text="מערכת אימוץ חיות מחמד" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
        <VBox.margin>
            <Insets bottom="20.0"/>
        </VBox.margin>
    </Label>
    
    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="שם משתמש:" prefWidth="100"/>
            <TextField fx:id="usernameField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT">
            <Label text="סיסמה:" prefWidth="100"/>
            <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" nodeOrientation="RIGHT_TO_LEFT"/>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER">
            <Button text="התחברות" onAction="#handleLogin" prefWidth="120" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="הרשמה" onAction="#handleRegister" prefWidth="120" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
        
        <TextArea fx:id="messageLabel" editable="false" wrapText="true" prefRowCount="2" prefWidth="250" style="-fx-control-inner-background: white; -fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-border-color: transparent;"/>
    </VBox>
    
    <Label text="קבוצה 780-60 | דניאל מנחם ושלי סייאה" style="-fx-font-size: 10px; -fx-text-fill: #95a5a6;"/>
</VBox>
